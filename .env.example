# Copy to .env.local and fill in from the Supabase dashboard (Project Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Microsoft Graph, for emailing students their seats. From Entra admin center ->
# App registrations -> Exam Seating MVP (Overview, and Certificates & secrets).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Server-only. Never prefix with NEXT_PUBLIC_.
MICROSOFT_CLIENT_SECRET=

# Shared key the RFID card readers send with every scan. Any long random string;
# the same value goes into the reader firmware. Server-only.
READER_API_KEY=
